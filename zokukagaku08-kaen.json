  {
   "seq": "8",
   "text": "つぼくらめなるゝもはかな鳥のねをきゝ玄る人もあらぬひとやに",
   "kana": "",
   "speaker": "",
   "page": 124,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "まばゆさに折りてや人のかざすらむ夕日い花の時雨ならねど",
   "kana": "",
   "speaker": "",
   "page": 124,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "風ふかぬ池比はちすの露の玉ゆらぐや魚のあさるなるらむ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "夕ゴく日入江をぐらきむら蘆にのこる光やほたるなるらむ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "風かをる花たちばなの夕やみに見ぬ世を恐ぶこがくれの宿",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "まちわぶる心のやみにともすれがなかぬこゑきくやま時鳥",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "さ蕨もまだもえいでぬ杣木山こぞのとぶさに春かぜぞふく",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "色も香もあかぬものから野に山にさかぬ恨の深みぐさかな",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "苗代を雨にまかせて日をふるや〓づが心のはれまなるらむ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "春の野に遊ぶ雲雀よさのみなど思ひあがりて音をバ鳴らむ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "駒とめてをちかた人の袖はらふ木陰や花のふヾきなるらむ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "ちりそめし今日ぞはじめて思ひ玄る昨日を花の盛なりとい",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "うゑざりし身をバ思はで今さらに花なき宿とかこつ春かな",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "花おのみいとひしことよ者玄らぬ宿ふもかぜいつらき習を",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "さし向ふ外山の峯の雲之ろし月いでくらしすだれろゝげよ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "いでてこし常世といづれ此浦比此夕なぎのみるめかりグね",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "月きよみ雲井のかりの玉章も手にとるばかりはるゝ夜は哉",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "尾花のみ袖うちふるか夕露いたちまふべくもあらぬ野分に",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "みちのくの荒野の牧のくつわ虫繋がぬ駒にねをやそふらむ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "月かげにみがくむぐらの夕露いあれたるやどの光なりけり",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "初秋のくべき夜之るし笹がにの糸にみだるゝ軒のゆふつゆ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "小舟こぐをとぢ凉しく雨はれて夕虹たかしたきの云まやま",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "雨はるゝ夕日の空にかつ見えてつばめむらがる夏の川づら",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "いけ水のはすの卷葉におく露い人玄れものみ玉やなすらむ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "綠玄く池のはちすの葉より葉につゆをまろばす風の涼しさ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "それをだに命とたのむうき中いなげの情もなさけならずや",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "あふと見バ現のうさや增るらむ夢おだおとい思ふものから",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "うかるべき身の行末も思ほえずこれをや戀の山路てふらむ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "あはれてふ人もこそあれ戀ならでかばかり物を思ふ身ならバ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "あはぬ夜を月によむまでなりあけり幾有明の空だのめして",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "いはずとも思ふ心い見ゆらむをうたてや人の玄らず顏なる",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "ふたしへに思へバこそい苦しけれ戀路の外に道なくもがな",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "何事をおもふとなしに木葉ちる冬の夕べいなみだぐましも",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "かくしても世にすみがまの夕烟心ぼそくもたちまじるかな",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "はし鷹の尾ぶさの鈴をかごとおて世のなりはひや聞しめすらむ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "風すさぶ森の木末のむらがらす雪にはたゝく聲のさむけさ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "時しあれバ操こだかき松だあもうづもるゝ世を雪に見る哉",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "ねになくや沖の小嶋のさよ千鳥なぎさを遠〓ゆきも歸らず",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "夕風のすがたながらに音たえて霜がれさむき軒の玄たをぎ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "うま車よるさへ月にところせき都おほぢい霜もおきあへず",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "やま川の氷魚おいあらで小車の網代によどむ風のもみち葉",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "月かげい嵐にさえてふくる夜の窓うつ雨や木のはなるらむ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "さびしさい風も音せぬ夕べ〓〓一つふたつとちる木葉かな",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "山風に木葉みだるゝたそがれの雲路や秋のゆくへなるらむ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "露霜にあれのみまさる小田の庵い今幾夜とか月のもるらむ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "山颪のふかぬたえまもほろ〓〓と木葉ちるまで秋更おけり",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "御狩野やをばなが浪のそこまでも鳥立もとめていさむ鷹人",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "みかり野や尾花そでふる秋風ふ小鷹のすゝの聲ぞみにしむ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "やよ時雨そめなつくしそ村紅葉色こき方やちらむとすらむ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "見し春の花ふもこりずちりやすきもみぢの秋にそむ心りを",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "こと繁き世あいまもほの薄原何をうづらのねのみなくらむ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "ながめずバ物も思はじうき秋をへだてもはてよ軒の夕ぎり",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "人とはぬ野寺の門をふくる夜の月にたゝくや山おろしの風",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "つらからぬ人の情やすゑつひに此身の仇とならむとすらむ",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "くものいのいぶせき窓を明暮にはらふもうれし風の竹むら",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "武藏野やなすり筑波り末とほき尾花此なみに浮ぶ云まやま",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "とひきていうらやましてふ都人も軒端ならべぬみ山べの里",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "かへりていまじはりふかき山路かな岩根づたひに通ふ柴人",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "驛路の一むら杉い見えながらめぐる田づらの道のはるけさ",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "草枕たれをあるじとなき野べもかきわかれゆく袖の路けさ",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "たび人のあす渡るべき川おとに耳そばだつる雨のおとかな",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "山高くきつゝ思へどはれ曇る雲いうき世の物あぞありける",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "見せばやな鄙の山路の小柴栗ゑむばかりなる苞ならねとも",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "雲の波たどる卅路のいゴこをうてる日の本の空とあふがむ",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "舟やうく山や沈むと見るばかりうねりぞ高き波の八玄ほぢ",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "かげうつる星を舟路のまさごおて浪靜なる夜はのうみづら",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "またや見む玉の薨を裾野にて夕日にみがくゆきの富士のね",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "花だにも八重いなか〓ヽこちたきをうたて葎の茂きやど哉",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "たが爲の小笠ふとてか賤の女が雨のふる江にま菅かるらむ",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "おらしふく安房の洲崎をたつ鷺い伊豆の下田の友や問らむ",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "等閑にきかめやけふも一年のひと日のかずにいりあひの鎖",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "野べいまだ露ちるばかりあらねどもほにいで初る麥の秋風",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "草も木もことやめしよに耳づくの耳引たてゝ何をきくらむ",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "鏡より鏡にうつすうしろクダ誰にそむけて見せむとすらむ",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "相馴れし契やふかきおはるゝもおふも心のひき〓〓にして",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "とりあへずふでにまかせて亂りうたむきびそへても奉る哉",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "いつしかと我命毛もとしふりぬ筆とるのみを身の業にして",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "千萬のいくさの君も老のくる、道をバえこそさゝへざりけれ",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "ゆきて見む身のはれ衣も中々にうれしき春の花ぐもりかな",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "野に山に心とびたつ春の日も身ふいこ蝶のはねをだおえも",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "老にけり身い墨染のあまならでつげの小櫛もうとくなる迄",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "今はとて別に手折る靑柳のかみもさかだつ今朝のかはかぜ",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "仇いとく亂れやすらむさきがけのまほおりきほふ野邊の遠方",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "こし方を思ひ渡せいうかりしもうれしかりしも夢の浮はし",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "うみの子のよにだお殘れよきをつむ身のいたづきハ人去らずとも",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "拾はれてよその乳房に笑ふ子の母いなきやむ折やなからむ",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "年さむきまくぞが原のきり〓〓す恨いつきじ霜いかむとも",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "二月や、黄金はなちる木のもとに現ともなくふすいたグ子ぞ",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "嵐にいちらしはてじと山櫻たをるやはな法をしむなるらむ",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "限ありてちるだにをしき櫻花うたてあらしの何さそふらむ",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "いのる其神のみ前のゆふかづらなびくばかりの契ともグな",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "なきつるゝかりグね高しみ吉野のよし野のさりの秋霧の空",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "芦の葉もやゝ露之ぼし難波潟こや秋さてる之るしなるらむ",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "心とやなきわたるらむきり〓〓もおのが淚の露ふ玄をれて",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "うらがるゝ秋の末野の淺ぢ原いまいく日とか露もおくらむ",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "黑髪のあゝる折おやかぞならぬひとの心のたクも見ゆらむ",
   "kana": "",
   "speaker": "",
   "page": 129,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "歎くらむ其たらちねよ黑髪のかゝれとてしも撫ぞや有けむ",
   "kana": "",
   "speaker": "",
   "page": 129,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "中々にかゝらましかバ露の身のとくあそ野べに消ゆべかりしク",
   "kana": "",
   "speaker": "",
   "page": 129,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "世のうさを心にかけぬもゝしきの大宮人いいとまあるらむ",
   "kana": "",
   "speaker": "",
   "page": 129,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "詠めわびぬ行末くらき身の上に思ひよそふる夕ぐれのくも",
   "kana": "",
   "speaker": "",
   "page": 129,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "うらやましよ渡る道のあやふさをかけ離れたる谷の玄ば橋",
   "kana": "",
   "speaker": "",
   "page": 129,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "眺むれがそゞろに寒し人めさへかれぬる霜のをうのべの松",
   "kana": "",
   "speaker": "",
   "page": 129,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "いきてよもあもいめでじと思ふ身に殊さら惜き月のいり方",
   "kana": "",
   "speaker": "",
   "page": 129,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "春だにもとはれぬ宿の櫻花いつをたのめてちりのこるらむ",
   "kana": "",
   "speaker": "",
   "page": 130,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "靜けしな眞之ばのいほの片折戶さして浮世にまつ事もおし",
   "kana": "",
   "speaker": "",
   "page": 130,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  }
 ],
